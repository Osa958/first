# Two quicksorts: a functional one that builds new lists, and an in-place
# Lomuto-partition version.

fn quicksort(xs) {
    if len(xs) <= 1 { return xs }
    let pivot = xs[len(xs) // 2]
    let less = filter(fn(x) => x < pivot, xs)
    let equal = filter(fn(x) => x == pivot, xs)
    let greater = filter(fn(x) => x > pivot, xs)
    return quicksort(less) + equal + quicksort(greater)
}

fn quicksort_in_place(a) {
    fn swap(i, j) {
        let t = a[i]
        a[i] = a[j]
        a[j] = t
    }
    fn partition(lo, hi) {
        let pivot = a[hi]
        let i = lo
        for j in range(lo, hi) {
            if a[j] < pivot {
                swap(i, j)
                i += 1
            }
        }
        swap(i, hi)
        return i
    }
    fn sort(lo, hi) {
        if lo < hi {
            let p = partition(lo, hi)
            sort(lo, p - 1)
            sort(p + 1, hi)
        }
    }
    sort(0, len(a) - 1)
    return a
}

# deterministic pseudo-random numbers (linear congruential generator)
fn make_rng(seed) {
    let state = seed
    return fn(limit) {
        state = (state * 1103515245 + 12345) % 2147483648
        return state % limit
    }
}

let rand = make_rng(42)
let data = map(fn(_) => rand(100), range(20))
print("input:   ", data)
print("sorted:  ", quicksort(data))
print("in-place:", quicksort_in_place(data.copy()))
print("words:   ", quicksort(["pear", "apple", "fig", "kiwi", "banana"]))

let big = map(fn(_) => rand(100000), range(2000))
let a = quicksort(big)
let b = quicksort_in_place(big.copy())
print("2000 items agree with builtin sort:", a == sorted(big) and b == a)
